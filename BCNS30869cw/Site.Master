<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="BCNS30869cw.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="HappyPaws Mauritius - adopt a rescued pet or responsibly surrender your pet" />
    <title>HappyPaws</title>

    <!-- Bootstrap 5.3.2 (shipped with Eduleb) -->
    <link rel="stylesheet" href="~/Assets/public/bootstrap/css/bootstrap.min.css" />
    <!-- Google Fonts used by Eduleb -->
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
    <!-- Icon fonts -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/Assets/public/fonts/font-awesome.min.css" />
    <link rel="stylesheet" href="~/Assets/public/fonts/themify-icons.css" />
    <!-- Plugin styles -->
    <link rel="stylesheet" href="~/Assets/public/owlcarousel/css/owl.carousel.css" />
    <link rel="stylesheet" href="~/Assets/public/owlcarousel/css/owl.theme.css" />
    <link rel="stylesheet" href="~/Assets/public/css/jquery-simple-mobilemenu.css" />
    <link rel="stylesheet" href="~/Assets/public/css/happypaws.css" />
    <link rel="stylesheet" href="~/Assets/public/css/animate.css" />
    <!-- Eduleb's main stylesheet (load last so it wins over the others) -->
    <link rel="stylesheet" href="~/Assets/public/css/style.css" />

    <!-- Hole #1: lets a page add its own extra CSS if it needs to -->
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">

        <!-- Step 3b: the navbar goes here -->


        <!-- START NAVBAR (from Eduleb) -->
        <div id="navigation" class="navbar-light bg-faded site-navigation">
            <div class="container-fluid">
                <div class="row">

                    <!-- Logo -->
                    <div class="col-20 align-self-center">
                        <div class="site-logo">
                            <a runat="server" href="~/Default.aspx"><i class="fa-solid fa-paw"></i>HappyPaws</a>
                        </div>
                    </div>

                    <!-- Desktop menu -->
                    <div class="col-60 d-flex">
                        <nav id="main-menu">
                            <ul>
                                <!-- Everyone sees these -->
                                <li><a runat="server" href="~/Default.aspx">Home</a></li>
                                <li><a runat="server" href="~/Catalogue.aspx">Pet Catalogue</a></li>
                                <li><a runat="server" href="~/Events.aspx">Events</a></li>

                                <!-- Only Adopters see this (switched on by C# after login) -->
                                <asp:PlaceHolder ID="phAdopterMenu" runat="server" Visible="false">
                                    <li class="menu-item-has-children"><a href="#">Adopt</a>
                                        <ul>
                                            <li><a runat="server" href="~/Adopter/AdvancedSearch.aspx">Advanced Search</a></li>
                                            <li><a runat="server" href="~/Adopter/MyApplications.aspx">My Applications</a></li>
                                            <li><a runat="server" href="~/Adopter/Profile.aspx">My Profile</a></li>
                                            <li><a runat="server" href="~/Member/Testimonial.aspx">Post a Testimonial</a></li>
                                        </ul>
                                    </li>
                                </asp:PlaceHolder>

                                <!-- Only Pet Owners see this -->
                                <asp:PlaceHolder ID="phOwnerMenu" runat="server" Visible="false">
                                    <li class="menu-item-has-children"><a href="#">Surrender</a>
                                        <ul>
                                            <li><a runat="server" href="~/Owner/SurrenderRequest.aspx">Surrender a Pet</a></li>
                                            <li><a runat="server" href="~/Owner/MyRequests.aspx">My Requests</a></li>
                                            <li><a runat="server" href="~/Owner/Documents.aspx">My Documents</a></li>
                                            <li><a runat="server" href="~/Member/Testimonial.aspx">Post a Testimonial</a></li>
                                        </ul>
                                    </li>
                                </asp:PlaceHolder>
                            </ul>
                        </nav>
                    </div>

                    <!-- Right side buttons (desktop only: d-none hides it, d-xl-block shows it on large screens) -->
                    <div class="col-20 d-none d-xl-block text-end align-self-center">
                        <!-- Guests -->
                        <asp:PlaceHolder ID="phGuestButtons" runat="server">
                            <a runat="server" href="~/Login.aspx" class="header-btn">Sign In</a>
                            <a runat="server" href="~/Register.aspx" class="btn_one">Register</a>
                        </asp:PlaceHolder>
                        <!-- Logged-in members: greeting (F31) and sign out (F29) -->
                        <asp:PlaceHolder ID="phMemberButtons" runat="server" Visible="false">
                            <asp:Label ID="lblGreeting" runat="server" CssClass="me-3" Text="Hi, Guest" />
                            <asp:LinkButton ID="btnSignOut" runat="server" CssClass="btn_one" CausesValidation="false">Sign Out</asp:LinkButton>
                        </asp:PlaceHolder>
                    </div>

                    <!-- Step 3b Part 4: YOUR mobile menu goes here -->

                    <!-- Mobile menu (shown on small screens instead of the desktop menu) -->
                    <ul class="mobile_menu">
                        <!-- Everyone sees these -->
                        <li><a runat="server" href="~/Default.aspx">Home</a></li>
                        <li><a runat="server" href="~/Catalogue.aspx">Pet Catalogue</a></li>
                        <li><a runat="server" href="~/Events.aspx">Events</a></li>

                        <!-- Only Adopters -->
                        <asp:PlaceHolder ID="phAdopterMobile" runat="server" Visible="false">
                            <li><a href="#">Adopt</a>
                                <ul class="sub-menu">
                                    <li><a runat="server" href="~/Adopter/AdvancedSearch.aspx">Advanced Search</a></li>
                                    <li><a runat="server" href="~/Adopter/MyApplications.aspx">My Applications</a></li>
                                    <li><a runat="server" href="~/Adopter/Profile.aspx">My Profile</a></li>
                                    <li><a runat="server" href="~/Member/Testimonial.aspx">Post a Testimonial</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>

                        <!-- Only Pet Owners: YOUR TURN (see below) -->
                        <asp:PlaceHolder ID="phOwnerMobile" runat="server" Visible="false">
                            <li><a href="#">Surrender</a>
                                <ul class="sub-menu">
                                    <li><a runat="server" href="~/Owner/SurrenderRequest.aspx">Surrender a Pet</a></li>
                                    <li><a runat="server" href="~/Owner/MyRequests.aspx">My Requests</a></li>
                                    <li><a runat="server" href="~/Owner/Documents.aspx">My Documents</a></li>
                                    <li><a runat="server" href="~/Member/Testimonial.aspx">Post a Testimonial</a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>

                        <!-- Guests: Sign In / Register (the right-side buttons are hidden on phones) -->
                        <asp:PlaceHolder ID="phGuestMobile" runat="server">
                            <li><a runat="server" href="~/Login.aspx">Sign In</a></li>
                            <li><a runat="server" href="~/Register.aspx">Register</a></li>
                        </asp:PlaceHolder>

                        <!-- Logged-in members: Sign Out -->
                        <asp:PlaceHolder ID="phMemberMobile" runat="server" Visible="false">
                            <li>
                                <asp:LinkButton ID="btnSignOutMobile" runat="server" CausesValidation="false">Sign Out</asp:LinkButton></li>
                        </asp:PlaceHolder>
                    </ul>


                </div>
            </div>
        </div>
        <!-- END NAVBAR -->


        <!-- Hole #2: each page's own content goes here -->
        <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

        <!-- Step 3c: the footer goes here -->

    </form>

    <!-- Site-wide scripts (needed on every page) -->
    <script src="<%: ResolveUrl("~/Assets/public/js/jquery-1.12.4.min.js") %>"></script>
    <script src="<%: ResolveUrl("~/Assets/public/bootstrap/js/bootstrap.min.js") %>"></script>
    <script src="<%: ResolveUrl("~/Assets/public/js/jquery-simple-mobilemenu.js") %>"></script>
    <script src="<%: ResolveUrl("~/Assets/public/js/scrolltopcontrol.js") %>"></script>
    <script src="<%: ResolveUrl("~/Assets/public/js/wow.min.js") %>"></script>
    <script src="<%: ResolveUrl("~/Assets/public/js/site.js") %>"></script>

    <!-- Hole #3: lets a page add its own scripts (e.g. the home page's testimonial slider) -->
    <asp:ContentPlaceHolder ID="scripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
